# ── Postgres (Docker db service + backend DATABASE_URL) ──────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fintrack

# Local (non-Docker) backend connects directly; Docker backend builds
# DATABASE_URL from the POSTGRES_* vars in docker-compose.yml.
# Local dev: use your macOS username (no password). Docker overrides this with its own URL.
DATABASE_URL=postgresql+asyncpg://YOUR_MACOS_USERNAME@localhost:5432/fintrack

# ── Backend ──────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-cryptographically-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:8081","http://localhost:8080"]
APPLE_CLIENT_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL=your-email@gmail.com
VERIFICATION_CODE_EXPIRE_MINUTES=10

# ── Frontend (Expo only reads EXPO_PUBLIC_* vars) ────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_USE_MOCK=false

# ── Flags ────────────────────────────────────────────────────────
IS_DROP_TABLES=true
