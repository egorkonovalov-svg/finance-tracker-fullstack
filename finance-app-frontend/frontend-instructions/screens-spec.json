{
  "appName": "FinTrack",
  "frameSize": { "width": 390, "height": 844 },
  "designTokens": {
    "colors": {
      "light": {
        "background": "#F4F1EB",
        "paperBackground": "#F8F5EE",
        "paperAccent": "#E6DFCF",
        "text": "#111827",
        "textSecondary": "#6B7280",
        "textMuted": "#9CA3AF",
        "primary": "#2563EB",
        "income": "#16A34A",
        "expense": "#DC2626",
        "tabBar": "rgba(255,255,255,0.88)",
        "cardGlass": "rgba(255,255,255,0.72)",
        "cardBorder": "rgba(148,163,184,0.35)",
        "inputBorder": "rgba(148,163,184,0.5)",
        "inputBg": "rgba(255,255,255,0.72)",
        "blurRadius": 28
      },
      "dark": {
        "background": "#050814",
        "paperBackground": "rgba(15,23,42,1)",
        "paperAccent": "rgba(30,64,175,1)",
        "text": "#E5E7EB",
        "textSecondary": "#9CA3AF",
        "textMuted": "#6B7280",
        "primary": "#60A5FA",
        "income": "#22C55E",
        "expense": "#F97373",
        "tabBar": "rgba(15,23,42,0.94)",
        "cardGlass": "rgba(15,23,42,0.82)",
        "cardBorder": "rgba(148,163,184,0.4)",
        "inputBorder": "rgba(148,163,184,0.45)",
        "inputBg": "rgba(15,23,42,0.9)",
        "blurRadius": 32
      },
      "palette": {
        "indigo": "#2563EB",
        "indigoLight": "#60A5FA",
        "indigoDark": "#1D4ED8",
        "emerald": "#22C55E",
        "red": "#EF4444"
      }
    },
    "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48 },
    "radius": { "sm": 10, "md": 14, "lg": 18, "xl": 22, "2xl": 28, "full": 9999 },
    "fontSize": { "xs": 11, "sm": 13, "md": 15, "lg": 17, "xl": 20, "2xl": 24, "3xl": 30, "4xl": 36 },
    "fontFamily": {
      "heading": "Outfit Bold",
      "headingMedium": "Outfit SemiBold",
      "body": "DM Sans Regular",
      "bodyMedium": "DM Sans Medium",
      "bodySemiBold": "DM Sans SemiBold"
    },
    "shadow": {
      "paperSoft": "0 18px 55px rgba(15,23,42,0.08)",
      "glass": "0 20px 60px rgba(15,23,42,0.25)"
    },
    "effects": {
      "blurGlass": 28,
      "borderHairline": 0.5
    }
  },
  "pages": [
    {
      "id": "auth-flow",
      "name": "Auth Flow",
      "screens": [
        {
          "id": "welcome",
          "name": "Welcome",
          "route": "/welcome",
          "sections": [
            { "name": "Spacer", "type": "spacer" },
            { "name": "Center", "type": "block", "elements": ["Icon circle (wallet)", "Title: FinTrack", "Tagline: Take control of your finances"] },
            { "name": "Bottom", "type": "block", "elements": ["Button: Get Started", "Arrow icon"] }
          ]
        },
        {
          "id": "auth",
          "name": "Auth (Login / Sign Up)",
          "route": "/auth",
          "sections": [
            { "name": "Header", "elements": ["Wallet icon circle", "Title: Welcome back / Create account", "Subtitle: Sign in to continue / Start tracking your finances"] },
            { "name": "Mode Toggle", "elements": ["Log In", "Sign Up"] },
            { "name": "Form", "elements": ["Name (signup only)", "Email", "Password", "Primary button: Log In / Sign Up"] },
            { "name": "Divider", "elements": ["or continue with"] },
            { "name": "Social", "elements": ["Google button", "Apple button (iOS)"] }
          ]
        },
        {
          "id": "verify-code",
          "name": "Verify Code",
          "route": "/verify-code",
          "sections": [
            { "name": "Back", "elements": ["Back button"] },
            { "name": "Header", "elements": ["Mail icon circle", "Title: Check your email", "Subtitle: We sent a 6-digit code to {email}"] },
            { "name": "Code", "elements": ["6 digit input boxes", "Error message (optional)", "Verifying... (optional)"] },
            { "name": "Resend", "elements": ["Didn't receive the code?", "Resend in Xs / Resend Code"] }
          ]
        }
      ]
    },
    {
      "id": "main-tabs",
      "name": "Main App (Tabs)",
      "tabs": [
        { "id": "dashboard", "name": "Dashboard", "icon": "home", "route": "/(tabs)" },
        { "id": "transactions", "name": "Transactions", "icon": "list", "route": "/(tabs)/transactions" },
        { "id": "add", "name": "Add", "icon": "add (center FAB)", "route": "/(tabs)/add" },
        { "id": "analytics", "name": "Analytics", "icon": "bar-chart", "route": "/(tabs)/analytics" },
        { "id": "settings", "name": "Settings", "icon": "settings", "route": "/(tabs)/settings" }
      ],
      "screens": [
        {
          "id": "dashboard",
          "name": "Dashboard",
          "tabId": "dashboard",
          "sections": [
            { "name": "Header", "elements": ["Greeting, {userName}", "Your Finances (paper headline style)"] },
            { "name": "Balance Card", "elements": ["Frosted glass card: Total Balance", "Large amount on paper backdrop", "Pills row: Income | Expenses"] },
            { "name": "Summary Row", "elements": ["Three glass cards: Income", "Expenses", "Savings"] },
            { "name": "Recent Transactions", "elements": ["Section title on paper", "List of transactions in subtle glass rows or paper empty state"] }
          ]
        },
        {
          "id": "transactions",
          "name": "Transactions",
          "tabId": "transactions",
          "sections": [
            { "name": "Header", "elements": ["Title: Transactions"] },
            { "name": "Filters", "elements": ["Search input", "All / Expense / Income chips"] },
            { "name": "List", "elements": ["Section headers (Today, Yesterday, date)", "Transaction rows (long-press to delete)"] }
          ]
        },
        {
          "id": "add",
          "name": "New Transaction",
          "tabId": "add",
          "sections": [
            { "name": "Header", "elements": ["New Transaction"] },
            { "name": "Type Toggle", "elements": ["Expense", "Income"] },
            { "name": "Amount", "elements": ["Amount label", "Currency symbol + input"] },
            { "name": "Category", "elements": ["Category label", "Category chips grid"] },
            { "name": "Note", "elements": ["Note input"] },
            { "name": "Date", "elements": ["Date picker row"] },
            { "name": "Recurring", "elements": ["Recurring toggle"] },
            { "name": "Submit", "elements": ["Add Transaction button"] }
          ]
        },
        {
          "id": "analytics",
          "name": "Analytics",
          "tabId": "analytics",
          "sections": [
            { "name": "Header", "elements": ["Analytics"] },
            { "name": "Period", "elements": ["Month | Quarter | Year selector"] },
            { "name": "Charts", "elements": ["Bar chart (7 days)", "Pie chart (expense by category)", "Summary totals"] },
            { "name": "Top Categories", "elements": ["Top 5 categories list (icon, name, amount in selected currency)"] }
          ]
        },
        {
          "id": "settings",
          "name": "Settings",
          "tabId": "settings",
          "sections": [
            { "name": "Header", "elements": ["Settings"] },
            { "name": "APPEARANCE", "elements": ["Dark Mode toggle", "Light / Dark / System pills"] },
            { "name": "LANGUAGE", "elements": ["Locale pills: English / Russian"] },
            { "name": "CURRENCY", "elements": ["Currency row (collapsible)", "Currency option list (USD, EUR, RUB, GBP, JPY with symbols)", "Note: amounts stored in RUB, displayed in selected currency"] },
            { "name": "DATA", "elements": ["Manage Categories row"] },
            { "name": "ABOUT", "elements": ["FinTrack v1.0.0", "Personal finance tracking app"] },
            { "name": "Logout", "elements": ["Log out button"] }
          ]
        }
      ]
    },
    {
      "id": "secondary",
      "name": "Secondary Screens",
      "screens": [
        {
          "id": "transaction-detail",
          "name": "Transaction Detail",
          "route": "/transaction/[id]",
          "sections": [
            { "name": "Header", "elements": ["Back", "Transaction", "Edit/Save"] },
            { "name": "Content", "elements": ["Type badge (Income / Expense)", "Signed amount", "Category", "Note (optional)", "Date", "Recurring badge (optional)", "Delete button"] },
            { "name": "Edit", "elements": ["Type toggle (Income / Expense)", "Amount field", "Category chips", "Date picker", "Note field", "Save / Cancel buttons"] }
          ]
        },
        {
          "id": "categories",
          "name": "Manage Categories",
          "route": "/categories",
          "sections": [
            { "name": "Header", "elements": ["Back", "Manage Categories"] },
            { "name": "List", "elements": ["Category rows (icon, name, type, color dot)", "Add/edit category form (name, type: income/expense/both, icon picker, color picker)"] }
          ]
        }
      ]
    }
  ],
  "tabBarSpec": {
    "height": 88,
    "position": "bottom",
    "style": "floating iOS glass over paper",
    "items": [
      { "label": "Dashboard", "icon": "home" },
      { "label": "Transactions", "icon": "list" },
      { "label": "", "icon": "add", "centerFAB": true },
      { "label": "Analytics", "icon": "bar-chart" },
      { "label": "Settings", "icon": "settings" }
    ]
  }
}
